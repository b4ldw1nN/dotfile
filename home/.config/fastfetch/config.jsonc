{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/zoro/.config/fastfetch/l.txt",
        "color": {
            "1": "#939BA2"
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 4
        }
    },
    "display": {
        "separator": " 󰁔  ",
        "color": {
            "keys": "#F8D4FF"
        }
    },
    "modules": [
        "break",
        {
            "type": "title",
            "color": {
                "user": "#F8D4FF",
                "at": "white",
                "host": "#F8D4FF"
            }
        },
        "break",
        {
            "type": "os",
            "key": "  OS    "
        },
        {
            "type": "wm",
            "key": "  WM    "
        },
        {
            "type": "packages",
            "key": "󰏗  PKGS  "
        },
        {
            "type": "shell",
            "key": "  SHELL "
        },
        {
            "type": "kernel",
            "key": "  KERN  "
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "󰔚  TIME  "
        },
        {
            "type": "command",
            "key": "󰃭  AGE   ",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference days"
        },
        {
            "type": "memory",
            "key": "󰍛  MEM   "
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break"
    ]
}
